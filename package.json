{
	"name": "nuxt-app",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"format": "prettier . --cache --write",
		"format:check": "prettier . --cache --check",
		"lint": "eslint . --cache",
		"lint:fix": "eslint . --fix --cache",
		"preview": "nuxt preview",
		"preinstall": "npx only-allow pnpm",
		"postinstall": "nuxt prepare",
		"prepare": "husky || true",
		"typecheck": "nuxt typecheck",
		"check-quality": "pnpm lint && pnpm typecheck && pnpm format:check"
	},
	"dependencies": {
		"@iconify-json/lucide": "^1.2.127",
		"@nuxt/icon": "2.5.1",
		"@nuxtjs/color-mode": "4.0.1",
		"@nuxtjs/i18n": "10.6.0",
		"@nuxtjs/seo": "5.3.14",
		"@tailwindcss/vite": "^4.3.3",
		"nuxt": "^4.5.2",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.42",
		"vue-router": "^5.3.0"
	},
	"devDependencies": {
		"@intlify/eslint-plugin-vue-i18n": "^4.5.1",
		"@nuxt/eslint": "1.17.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "~10.1.8",
		"eslint-plugin-check-file": "~3.3.2",
		"eslint-plugin-jsonc": "^3.4.2",
		"husky": "~9.1.7",
		"lint-staged": "^17.4.1",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^7.0.2",
		"vue-tsc": "^3.3.11"
	}
}
